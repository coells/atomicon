{
    "name": "atomicon",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
        "test": "playwright test",

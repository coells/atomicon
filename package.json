    "packageManager": "pnpm@10.18.3",
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/node": "^26.5.1",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    }
}
